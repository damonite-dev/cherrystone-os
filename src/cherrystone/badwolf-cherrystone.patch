+/* Cherrystone: the "+" sits on the last tab, right after its close button */
+static gboolean
+cherry_plus_refresh(gpointer data)
+{
+	GtkNotebook *nb = GTK_NOTEBOOK(data);
+	gint n          = gtk_notebook_get_n_pages(nb);
+	for(gint i = 0; i < n; i++)
+	{
+		GtkWidget *lab = gtk_notebook_get_tab_label(nb, gtk_notebook_get_nth_page(nb, i));
+		GtkWidget *plus = lab ? g_object_get_data(G_OBJECT(lab), "cherry-plus") : NULL;
+		if(plus) gtk_widget_set_visible(plus, i == n - 1);
+	}
+	return G_SOURCE_REMOVE;
+}
+
+static void
+cherry_plus_pagesCb(GtkNotebook *nb, GtkWidget *UNUSED(child), guint UNUSED(num), gpointer UNUSED(d))
+{
+	g_idle_add(cherry_plus_refresh, nb);
 }
 
