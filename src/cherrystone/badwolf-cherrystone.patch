+/* Cherrystone: a friendly page when a site can't be reached */
+static gboolean
+cherryCb_load_failed(WebKitWebView *webView,
+					 WebKitLoadEvent UNUSED(load_event),
+					 gchar *failing_uri,
+					 GError *error,
+					 gpointer UNUSED(user_data))
+{
+	gchar *page = NULL;
+	if(error->domain == WEBKIT_POLICY_ERROR || error->domain == WEBKIT_DOWNLOAD_ERROR ||
+	   error->domain == g_quark_try_string("WebKitPluginError") ||
+	   g_error_matches(error, WEBKIT_NETWORK_ERROR, WEBKIT_NETWORK_ERROR_CANCELLED))
+		return FALSE;
+	if(failing_uri == NULL || g_str_has_prefix(failing_uri, "file:")) return FALSE;
+	if(!g_file_get_contents("/usr/share/cherrystone/error.html", &page, NULL, NULL)) return FALSE;
+	gchar *safe   = g_markup_escape_text(failing_uri, -1);
+	gchar **parts = g_strsplit(page, "@URL@", -1);
+	gchar *html   = g_strjoinv(safe, parts);
+	webkit_web_view_load_alternate_html(webView, html, failing_uri, NULL);
+	g_free(html);
+	g_strfreev(parts);
+	g_free(safe);
+	g_free(page);
+	return TRUE;
+}
+
+/* Cherrystone: history, for the Ctrl+H page (~/.local/share/cherrystone/history.js) */
+static void
+cherryCb_load_changed(WebKitWebView *webView, WebKitLoadEvent load_event, gpointer UNUSED(user_data))
+{
+	if(load_event != WEBKIT_LOAD_FINISHED) return;
+	const gchar *uri = webkit_web_view_get_uri(webView);
+	if(uri == NULL || !(g_str_has_prefix(uri, "http://") || g_str_has_prefix(uri, "https://"))) return;
+	const gchar *title = webkit_web_view_get_title(webView);
+	if(title == NULL) title = "";
+	gchar *dir = g_build_filename(g_get_user_data_dir(), "cherrystone", NULL);
+	g_mkdir_with_parents(dir, 0700);
+	gchar *path = g_build_filename(dir, "history.js", NULL);
+	gchar *u	= g_base64_encode((const guchar *)uri, strlen(uri));
+	gchar *t	= g_base64_encode((const guchar *)title, strlen(title));
+	FILE *f	 = fopen(path, "a");
+	if(f != NULL)
+	{
+		fprintf(f, "H(\"%s\",\"%s\",%ld);\n", u, t, (long)time(NULL));
+		fclose(f);
+	}
+	g_free(t);
+	g_free(u);
+	g_free(path);
+	g_free(dir);
+}
